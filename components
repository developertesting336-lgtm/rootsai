'use client';

import { Question } from '@/lib/data/assessment-questions';
import { useCallback } from 'react';

interface QuestionCardProps {
  question: Question;
  value: string | number | null;
  onChange: (value: string | number) => void;
  disabled?: boolean;
}

export function QuestionCard({
  question,
  value,
  onChange,
  disabled = false,
}: QuestionCardProps) {
  const handleScaleChange = useCallback(
    (e: React.ChangeEvent<HTMLInputElement>) => {
      onChange(parseInt(e.target.value));
    },
    [onChange]
  );

  const handleSelectChange = useCallback(
    (e: React.ChangeEvent<HTMLSelectElement>) => {
      onChange(e.target.value);
    },
    [onChange]
  );

  const handleButtonClick = useCallback(
    (optionValue: string | number) => {
      onChange(optionValue);
    },
    [onChange]
  );

  return (
    <div className="border border-roots-border rounded-lg p-6 bg-white">
      {/* Question Text */}
      <h3 className="text-lg font-semibold text-roots-navy-900 mb-4">{question.text}</h3>

      {question.hint && (
        <p className="text-sm text-roots-muted mb-4 italic">{question.hint}</p>
      )}

      {/* Single Select - Button Group */}
      {question.type === 'single-select' && question.options && (
        <div className="space-y-3">
          {question.options.map((option) => (
            <button
              key={option.value}
              onClick={() => handleButtonClick(option.value)}
              disabled={disabled}
              className={`w-full text-left px-4 py-3 rounded-lg border-2 transition-colors ${
                value === option.value
                  ? 'border-roots-navy-900 bg-roots-navy-900 text-white'
                  : 'border-roots-border hover:border-roots-navy-900'
              } disabled:opacity-50 disabled:cursor-not-allowed`}
            >
              <span className="font-medium">{option.label}</span>
            </button>
          ))}
        </div>
      )}

      {/* Scale */}
      {question.type === 'scale' && question.scale && (
        <div className="space-y-4">
          <div className="flex justify-between text-xs font-semibold text-roots-muted">
            <span>{question.scale.minLabel}</span>
            <span>{question.scale.maxLabel}</span>
          </div>

          <div className="flex gap-2">
            {Array.from(
              { length: question.scale.max - question.scale.min + 1 },
              (_, i) => question.scale!.min + i
            ).map((scaleValue) => (
              <button
                key={scaleValue}
                onClick={() => handleButtonClick(scaleValue)}
                disabled={disabled}
                className={`flex-1 h-12 rounded-lg border-2 font-semibold transition-colors ${
                  value === scaleValue
                    ? 'border-roots-navy-900 bg-roots-navy-900 text-white'
                    : 'border-roots-border hover:border-roots-navy-900'
                } disabled:opacity-50 disabled:cursor-not-allowed`}
              >
                {scaleValue}
              </button>
            ))}
          </div>
        </div>
      )}

      {/* Multi Select */}
      {question.type === 'multi-select' && question.options && (
        <div className="space-y-3">
          {question.options.map((option) => (
            <label
              key={option.value}
              className="flex gap-3 p-3 border border-roots-border rounded-lg hover:bg-roots-light cursor-pointer"
            >
              <input
                type="checkbox"
                value={option.value}
                disabled={disabled}
                className="w-4 h-4 rounded border-roots-border mt-0.5"
              />
              <span className="text-sm text-roots-charcoal">{option.label}</span>
            </label>
          ))}
        </div>
      )}

      {/* Validation Message */}
      {question.required && value === null && (
        <p className="text-xs text-status-error mt-2">This question is required</p>
      )}
    </div>
  );
}
